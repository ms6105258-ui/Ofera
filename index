<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Ofera - أوفيرا</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="style.css">

  <!-- PWA Meta Tags -->
  <meta name="theme-color" content="#00b86b"/>
  <meta name="apple-mobile-web-app-capable" content="yes"/>
  <meta name="apple-mobile-web-app-status-bar-style" content="black"/>
  <meta name="apple-mobile-web-app-title" content="Ofera"/>
  <link rel="apple-touch-icon" href="icons/icon-192.png"/>
  
  <!-- manifest for PWA -->
  <link rel="manifest" href="manifest.json">

  <!-- Firebase -->
  <script src="https://www.gstatic.com/firebasejs/8.10.0/firebase-app.js"></script>
  <script src="https://www.gstatic.com/firebasejs/8.10.0/firebase-database.js"></script>
  <script src="https://www.gstatic.com/firebasejs/8.10.0/firebase-auth.js"></script>
</head>
<body>
  <!-- Install Button -->
  <div id="installContainer" style="display: none;">
    <button id="installBtn" class="install-btn">📲 تثبيت التطبيق</button>
  </div>

  <!-- Admin Panel Button -->
  <div id="adminPanelBtn" style="display: none;">
    <button onclick="navigateTo('admin')" class="admin-btn">⚙️ لوحة التحكم</button>
  </div>

  <!-- language switch -->
  <div class="lang-switch" id="langSwitch" onclick="toggleLanguage()">
    <span id="lang-icon">🌐</span> <span id="lang-text">EN</span>
  </div>

  <!-- CART FLOATING BUTTON -->
  <div id="cartFloatBtn" class="cart-float-btn" onclick="navigateTo('cart')" style="display: none;">
    🛒 <span id="cartCount">0</span>
  </div>

  <!-- LOGIN REQUIRED -->
  <section id="auth-required" class="page active">
    <div class="center-box">
      <h1 class="welcome">مرحبًا بك في</h1>
      <div class="brand-row">
        <h2 class="brand">أوفيرا</h2>
      </div>
      <p class="subtitle">
        <span class="icon">🛍️</span>
        <span class="subtitle-text">العروض الذكية بين إيديك</span>
      </p>

      <div class="auth-options">
        <button class="main-btn" onclick="showLogin()">تسجيل الدخول</button>
        <button class="main-btn secondary" onclick="showRegister()">إنشاء حساب جديد</button>
      </div>
    </div>
  </section>

  <!-- LOGIN FORM -->
  <section id="login" class="page">
    <button class="back-btn" onclick="showAuthRequired()">عودة</button>

    <div class="center-box auth-box">
      <h2 class="page-title">تسجيل الدخول</h2>

      <input id="loginEmail" type="email" placeholder="البريد الإلكتروني" />
      <input id="loginPassword" type="password" placeholder="كلمة المرور" />
      <button class="main-btn" onclick="loginUser()">تسجيل الدخول</button>

      <p class="error-msg" id="loginError"></p>
      <p class="toggle-text" onclick="showRegister()">ليس لديك حساب؟ سجل الآن</p>
    </div>
  </section>

  <!-- REGISTER FORM -->
  <section id="register" class="page">
    <button class="back-btn" onclick="showAuthRequired()">عودة</button>

    <div class="center-box auth-box">
      <h2 class="page-title">إنشاء حساب جديد</h2>

      <input id="regName" type="text" placeholder="الاسم الكامل" />
      <input id="regEmail" type="email" placeholder="البريد الإلكتروني" />
      <input id="regPhone" type="tel" placeholder="رقم الهاتف" />
      <input id="regPassword" type="password" placeholder="كلمة المرور" />
      <input id="regConfirmPassword" type="password" placeholder="تأكيد كلمة المرور" />
      
      <button class="main-btn" onclick="registerUser()">إنشاء الحساب</button>

      <p class="error-msg" id="registerError"></p>
      <p class="toggle-text" onclick="showLogin()">لديك حساب بالفعل؟ سجل دخول</p>
    </div>
  </section>

  <!-- HOME -->
  <section id="home" class="page">
    <div class="center-box">
      <h1 class="welcome" data-ar="مرحبًا بك في" data-en="Welcome to">مرحبًا بك في</h1>
      <div class="brand-row">
        <h2 class="brand" data-ar="أوفيرا" data-en="Ofera">أوفيرا</h2>
      </div>
      <p class="subtitle" data-ar="العروض الذكية بين إيديك" data-en="Smart offers at your fingertips">
        <span class="icon">🛍️</span>
        <span class="subtitle-text">العروض الذكية بين إيديك</span>
      </p>

      <div class="home-actions">
        <button class="main-btn" onclick="navigateTo('offers')">🛍️ العروض</button>
        <button class="main-btn secondary" onclick="navigateTo('business-options')">🏪 الدخول كبائع</button>
        <button class="main-btn outline" onclick="logout()">🚪 تسجيل الخروج</button>
      </div>
    </div>

    <div class="home-sign">Ofera © Mahmoud Shaban</div>
  </section>

  <!-- BUSINESS OPTIONS -->
  <section id="business-options" class="page">
    <button class="back-btn" onclick="navigateTo('home')">عودة</button>

    <div class="center-box">
      <h2 class="page-title">خيارات البائع</h2>

      <button class="main-btn" onclick="navigateTo('business-login')">🔐 دخول البائع</button>
      <button class="main-btn secondary" onclick="navigateTo('business-register')">📝 تسجيل بائع جديد</button>
    </div>
  </section>

  <!-- BUSINESS LOGIN -->
  <section id="business-login" class="page">
    <button class="back-btn" onclick="navigateTo('business-options')">عودة</button>

    <div class="center-box auth-box">
      <h2 class="page-title">دخول البائع</h2>

      <input id="businessEmail" type="email" placeholder="البريد الإلكتروني" />
      <input id="businessPassword" type="password" placeholder="كلمة المرور" />
      <button class="main-btn" onclick="businessLogin()">تسجيل الدخول</button>

      <p class="error-msg" id="businessLoginError"></p>
    </div>
  </section>

  <!-- BUSINESS REGISTER -->
  <section id="business-register" class="page">
    <button class="back-btn" onclick="navigateTo('business-options')">عودة</button>

    <div class="center-box auth-box">
      <h2 class="page-title">تسجيل بائع جديد</h2>

      <input id="bizName" type="text" placeholder="اسم المتجر/الشركة" />
      <input id="bizOwnerName" type="text" placeholder="اسم صاحب العمل" />
      <input id="bizEmail" type="email" placeholder="البريد الإلكتروني" />
      <input id="bizPhone" type="tel" placeholder="رقم الهاتف" />
      <input id="bizPassword" type="password" placeholder="كلمة المرور" />
      <input id="bizConfirmPassword" type="password" placeholder="تأكيد كلمة المرور" />
      
      <button class="main-btn" onclick="businessRegister()">تسجيل الحساب</button>

      <p class="error-msg" id="businessRegisterError"></p>
    </div>
  </section>

  <!-- OFFERS LIST -->
  <section id="offers" class="page">
    <button class="back-btn" onclick="navigateTo('home')">الرئيسية</button>

    <div class="center-box offers-box">
      <h2 class="page-title">العروض الحالية</h2>

      <!-- SEARCH AND FILTERS -->
      <div class="search-filters">
        <input type="text" id="searchInput" placeholder="ابحث في العروض..." class="search-input" />
        <select id="categoryFilter" class="category-filter">
          <option value="all">جميع التصنيفات</option>
          <option value="restaurants">مطاعم</option>
          <option value="cafes">كافيهات</option>
          <option value="markets">سوبرماركت</option>
          <option value="clothes">ملابس</option>
          <option value="electronics">إلكترونيات</option>
          <option value="beauty">تجميل وعناية</option>
          <option value="services">خدمات</option>
          <option value="other">أخرى</option>
        </select>
      </div>

      <div id="offersContainer" class="offers-container">
        <!-- JS will render offers here -->
      </div>
    </div>
  </section>

  <!-- OFFER DETAILS -->
  <section id="offer-details" class="page">
    <button class="back-btn" onclick="goBack()">عودة</button>

    <div class="center-box">
      <div id="offerDetailsContent" class="details-content">
        <!-- JS fills offer details -->
      </div>

      <!-- ORDER FORM -->
      <div id="orderForm" class="order-form">
        <h3>طلب العرض</h3>
        <form id="customerOrderForm">
          <input type="text" id="customerName" placeholder="اسمك الكامل" required />
          <input type="tel" id="customerPhone" placeholder="رقم هاتفك" required />
          <input type="email" id="customerEmail" placeholder="بريدك الإلكتروني" required />
          <textarea id="customerNotes" placeholder="ملاحظات إضافية (اختياري)"></textarea>
          <div class="order-actions">
            <button type="button" class="main-btn" onclick="addToCart()">إضافة إلى السلة</button>
            <button type="button" class="main-btn secondary" onclick="orderNow()">طلب مباشر</button>
          </div>
        </form>
      </div>
    </div>
  </section>

  <!-- ADD OFFER -->
  <section id="add-offer" class="page">
    <button class="back-btn" onclick="goBack()">عودة</button>

    <div class="center-box">
      <h2 class="page-title">إضافة عرض جديد</h2>

      <form id="addOfferForm" class="add-offer-form">
        <label>اسم العرض</label>
        <input id="offerTitle" type="text" placeholder="عنوان العرض" required />

        <label>وصف العرض</label>
        <textarea id="offerDesc" placeholder="وصف مفصل للعرض" required></textarea>

        <label>السعر الأصلي</label>
        <input id="originalPrice" type="number" placeholder="السعر قبل الخصم" />

        <label>السعر بعد الخصم</label>
        <input id="discountedPrice" type="number" placeholder="السعر بعد الخصم" />

        <label>تصنيف العرض</label>
        <select id="offerCategory" required>
          <option value="">اختر التصنيف</option>
          <option value="restaurants">مطاعم</option>
          <option value="cafes">كافيهات</option>
          <option value="markets">سوبرماركت</option>
          <option value="clothes">ملابس</option>
          <option value="electronics">إلكترونيات</option>
          <option value="beauty">تجميل وعناية</option>
          <option value="services">خدمات</option>
          <option value="other">أخرى</option>
        </select>

        <label>مدة العرض</label>
        <input id="offerDuration" type="number" placeholder="عدد الأيام" />

        <label>صورة العرض (اختياري)</label>
        <input id="offerImage" type="file" accept="image/*" />

        <button type="submit" class="main-btn">إرسال العرض للموافقة</button>
      </form>
    </div>
  </section>

  <!-- CART -->
  <section id="cart" class="page">
    <button class="back-btn" onclick="goBack()">عودة</button>

    <div class="center-box">
      <h2 class="page-title">سلة التسوق</h2>

      <div id="cartItems" class="cart-items">
        <!-- JS fills cart items -->
      </div>

      <div id="cartEmpty" class="empty-state">
        <p>سلة التسوق فارغة</p>
        <button class="main-btn" onclick="navigateTo('offers')">تصفح العروض</button>
      </div>

      <div id="cartSummary" class="cart-summary" style="display: none;">
        <div class="summary-row">
          <span>عدد العناصر:</span>
          <span id="totalItems">0</span>
        </div>
        <div class="summary-row">
          <span>المجموع:</span>
          <span id="totalPrice">0 جنيه</span>
        </div>
        <button class="main-btn" onclick="checkout()">إتمام الطلب</button>
      </div>
    </div>
  </section>

  <!-- ADMIN PANEL -->
  <section id="admin" class="page">
    <button class="back-btn" onclick="navigateTo('home')">الرئيسية</button>

    <div class="center-box">
      <h2 class="page-title">لوحة التحكم</h2>

      <div class="admin-tabs">
        <button class="tab-btn active" onclick="openAdminTab('pending')">العروض المعلقة</button>
        <button class="tab-btn" onclick="openAdminTab('approved')">العروض المقبولة</button>
        <button class="tab-btn" onclick="openAdminTab('rejected')">العروض المرفوضة</button>
      </div>

      <div id="pendingOffers" class="admin-tab-content">
        <!-- JS fills pending offers -->
      </div>

      <div id="approvedOffers" class="admin-tab-content" style="display: none;">
        <!-- JS fills approved offers -->
      </div>

      <div id="rejectedOffers" class="admin-tab-content" style="display: none;">
        <!-- JS fills rejected offers -->
      </div>
    </div>
  </section>

  <script src="script.js"></script>

  <!-- PWA Installation and Service Worker -->
  <script>
    // Register Service Worker
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', function() {
        navigator.serviceWorker.register('service-worker.js')
          .then(reg => console.log('Service Worker Registered ✅', reg))
          .catch(err => console.log('Service Worker Failed ❌', err));
      });
    }

    // PWA Install Prompt
    let deferredPrompt;
    const installContainer = document.getElementById('installContainer');
    const installBtn = document.getElementById('installBtn');

    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferredPrompt = e;
      if (installContainer) installContainer.style.display = 'block';
    });

    if (installBtn) {
      installBtn.addEventListener('click', async () => {
        if (!deferredPrompt) return;
        
        deferredPrompt.prompt();
        const { outcome } = await deferredPrompt.userChoice;
        
        if (outcome === 'accepted') {
          if (installContainer) installContainer.style.display = 'none';
          console.log('User installed the PWA');
        }
        
        deferredPrompt = null;
      });
    }

    window.addEventListener('appinstalled', () => {
      if (installContainer) installContainer.style.display = 'none';
      deferredPrompt = null;
    });
  </script>
</body>
</html>
